---
import SideBar from "../components/SideBar.svelte";
import FieldView from "../components/FieldView.svelte";
import Modal from "../components/Modal.svelte";
import FieldControls from "../components/FieldControls.svelte";

import "../styles/fonts.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>3636 Autopilot Planner</title>
    </head>
    <body>
        <div class="main-layout">
            <div class="sidebar-container">
                <SideBar client:only />
            </div>
            <div class="right-panel">
                <div class="control-container">
                    <FieldControls client:only />
                </div>
                <div class="field-view-container">
                    <FieldView client:only />
                </div>
            </div>
        </div>
        <Modal client:only />
    </body>
</html>

<script>
    import { import_state_from_json } from "../scripts/export";
    import { export_state_to_json } from "../scripts/export";
    import {
        targets,
        type Target,
        settings,
        type Settings,
    } from "../scripts/store";
    import { set_theme } from "../scripts/theme";

    let latest_targets: Target[] = [];
    let latest_settings: Settings;
    let scheduled = false;

    settings.subscribe((value) => {
        latest_settings = value;
        set_theme(value.theme);
    });
    targets.subscribe((value) => {
        latest_targets = value;

        if (scheduled) return;
        scheduled = true;

        setTimeout(async () => {
            console.log("Exporting targets...");
            const json_export = export_state_to_json(
                latest_targets,
                latest_settings,
            );
            const directory = await navigator.storage.getDirectory();
            const file = await directory.getFileHandle("targets.json", {
                create: true,
            });

            const stream = await file.createWritable();
            await stream.write(json_export);
            await stream.close();

            scheduled = false;
        }, 250);

        window.addEventListener("dragover", (e) => {
            if (!e.dataTransfer) {
                return;
            }
            const fileItems = [...e.dataTransfer.items].filter(
                (item) => item.kind === "file",
            );
            if (fileItems.length > 0) {
                e.preventDefault();
            }
        });

        window.addEventListener("drop", async (ev) => {
            if (!ev.dataTransfer) {
                return;
            }

            if (
                [...ev.dataTransfer.items].some((item) => item.kind === "file")
            ) {
                ev.preventDefault();
            }
            console.log(ev.dataTransfer);

            const files = ev.dataTransfer.files;
            const save_data = files.item(0)!;
            const state = import_state_from_json(await save_data.text());
            targets.set(state.targets);
            settings.set(state.settings);
        });
    });

    await navigator.storage.getDirectory().then(async (dir) => {
        const file = await dir.getFileHandle("targets.json");
        const json = await file.getFile().then((file) => file.text());
        const state = import_state_from_json(json);
        targets.set(state.targets);
        settings.set(state.settings);
    });
</script>

<style>
    :root {
        --border-radius: 15px;

        --font-body: "Lato", sans-serif;
        --font-title: "Allrounder Baroque", serif;
    }

    body {
        margin: 0;

        background-color: var(--bg-0);
        font-family: var(--font-body);
        color: var(--fg);
    }

    :global(h1, h2, h2, h3, h4, h5, h6) {
        font-family: var(--font-title);
        font-weight: 200;
    }
    :global(h1) {
        margin-block: 0.2em;
    }
    :global(h2) {
        margin-block: 0.3em;
    }

    :global(input) {
        all: unset;
        border: 1px solid var(--fg);
        border-radius: 20px;
        padding: 4px;
        padding-inline: 8px;
        background-color: var(--bg-1);
        text-align: center;
    }

    :global(input[type="number"]) {
        -moz-appearance: textfield;
    }

    :global(input[type="number"]::-webkit-inner-spin-button),
    :global(input[type="number"]::-webkit-outer-spin-button) {
        -webkit-appearance: none;
        margin: 0;
    }

    .main-layout {
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: row;
    }
    .sidebar-container {
        width: 30vw;
        margin: 10px;
        padding: 10px;
        border-radius: var(--border-radius);
        overflow-y: scroll;
        background-color: var(--bg-2);
        z-index: 100;
    }
    .field-view-container {
        width: 100%;
        height: 100%;
        border-radius: var(--border-radius) 0 0 var(--border-radius);
        overflow: hidden;
    }
    .right-panel {
        display: flex;
        flex-direction: column;
        align-items: center;

        width: 100%;
        height: calc(100vh - 40px);
        padding-inline: 10px;
        padding-block: 20px;
    }
    .control-container {
        width: 50%;
        background-color: var(--bg-2);
        height: 24px;
        padding: 10px;
        border-radius: var(--border-radius);
    }
</style>
