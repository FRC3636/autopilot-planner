---
import SideBar from "../components/SideBar.svelte";
import FieldView from "../components/FieldView.svelte";
import "../styles/fonts.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>3636 Autopilot Planner</title>
    </head>
    <body>
        <div class="main-layout">
            <div class="sidebar-container">
                <SideBar client:only />
            </div>
            <div class="field-view-container">
                <FieldView client:only />
            </div>
        </div>
    </body>
</html>

<script>
    import { import_targets_from_json } from "../scripts/export";
    import { export_targets_to_json } from "../scripts/export";
    import {
        selected_target,
        targets,
        snapping_enabled,
        type Target,
    } from "../scripts/store";

    window.addEventListener("keydown", (e) => {
        switch (e.key) {
            case "Escape":
                selected_target.set(null);
                break;
            case "Alt":
                snapping_enabled.set(true);
        }
    });
    window.addEventListener("keyup", (e) => {
        switch (e.key) {
            case "Alt":
                snapping_enabled.set(false);
        }
    });

    let latestValue: Target[] = [];
    let scheduled = false;

    targets.subscribe((value) => {
        latestValue = value;

        if (scheduled) return;
        scheduled = true;

        setTimeout(async () => {
            console.log("Exporting targets...");
            const json_export = export_targets_to_json(latestValue);
            const directory = await navigator.storage.getDirectory();
            const file = await directory.getFileHandle("targets.json", {
                create: true,
            });

            const stream = await file.createWritable();
            await stream.write(json_export);
            await stream.close();

            scheduled = false;
        }, 250);
    });

    await navigator.storage.getDirectory().then(async (dir) => {
        const file = await dir.getFileHandle("targets.json");
        const json = await file.getFile().then((file) => file.text());
        targets.set(import_targets_from_json(json));
    });
</script>

<style>
    :root {
        --border-radius: 15px;

        --font-body: "Lato", sans-serif;
        --font-title: "Allrounder Baroque", serif;
    }

    body {
        margin: 0;

        background-color: #222;
        font-family: var(--font-body);
        color: #eee;
    }

    :global(h1, h2, h2, h3, h4, h5, h6) {
        font-family: var(--font-title);
        font-weight: 200;
    }
    :global(h1) {
        margin-block: 0.2em;
    }
    :global(h2) {
        margin-block: 0.3em;
    }

    .main-layout {
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: row;
    }
    .sidebar-container {
        width: 30vw;
        margin: 10px;
        padding: 10px;
        border-radius: var(--border-radius);
        overflow-y: scroll;
        background-color: #333;
        z-index: 100;
    }
    .field-view-container {
        width: 100%;
        padding: 10px;
        border-radius: var(--border-radius) 0 0 var(--border-radius);
        overflow: hidden;
    }
</style>
