---
import SideBar from "../components/SideBar.svelte";
import FieldView from "../components/FieldView.svelte";
import "../styles/fonts.css"
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>3636 Autopilot Planner</title>
    </head>
    <body>
        <div class="main-layout">
            <div class="sidebar-container">
                <SideBar client:only />
            </div>
            <div class="field-view-container">
                <FieldView client:only />
            </div>
        </div>
    </body>
</html>

<style>
    :root {
        --border-radius: 15px;

        --font-body: "Lato", sans-serif;
        --font-title: "Allrounder Baroque", serif;
    }

    body {
        margin: 0;

        background-color: #333;
        font-family: var(--font-body);
        color: #eee;
    }

    :global(h1, h2, h2, h3, h4, h5, h6) {
        font-family: var(--font-title);
        font-weight: 200;
    }
    :global(h1) {
        margin-block: 0.2em;
    }
    :global(h2) {
        margin-block: 0.3em
    }

    .main-layout {
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: row;
    }
    .sidebar-container {
        width: 30vw;
        padding: 10px;
    }
    .field-view-container {
        width: 100%;
        background-color: #222;
        padding: 10px;
        border-radius: var(--border-radius) 0 0 var(--border-radius);
    }
</style>
